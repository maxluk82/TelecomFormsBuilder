{
  "framework": null,
  "buildCommand": "node build.cjs",
  "outputDirectory": "public",
  "functions": {
    "api/gateway.js": {
      "includeFiles": "private/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/gateway?__path="
    },
    {
      "source": "/:path*",
      "destination": "/api/gateway?__path=:path*"
    }
  ]
}
